{
  "name": "css-snapshot",
  "version": "0.1.0",
  "description": "Snapshot the resolved, de-noised CSS of a live Chromium page (or one element) as one self-contained JSON that rebuilds the render offline. Uses the browser's own cascade engine over CDP.",
  "keywords": [
    "css",
    "computed-style",
    "cascade",
    "snapshot",
    "cdp",
    "chrome-devtools-protocol",
    "playwright",
    "mcp",
    "visual-regression"
  ],
  "license": "MIT",
  "author": "cevek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cevek/css-snapshot.git"
  },
  "homepage": "https://github.com/cevek/css-snapshot#readme",
  "bugs": "https://github.com/cevek/css-snapshot/issues",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "default": "./dist/playwright.js"
    },
    "./diff": {
      "types": "./dist/diff.d.ts",
      "default": "./dist/diff.js"
    },
    "./css": {
      "types": "./dist/css.d.ts",
      "default": "./dist/css.js"
    },
    "./pw-mcp": {
      "types": "./dist/pw-mcp-loader.d.ts",
      "default": "./dist/pw-mcp-loader.js"
    },
    "./pw-mcp.js": "./dist/pw-mcp.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "css-snapshot": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:e2e": "npm run build && vitest run --project e2e",
    "test:all": "npm run build && vitest run",
    "release": "node scripts/release.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@csstools/selector-specificity": "^6.0.0",
    "colord": "~2.9.3",
    "css-tree": "^3.2.1",
    "culori": "^4.0.2",
    "parsel-js": "^1.2.3",
    "postcss-selector-parser": "^7.1.4",
    "postcss-value-parser": "^4.2.0",
    "reduce-css-calc": "^2.1.8"
  },
  "peerDependencies": {
    "playwright": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@playwright/mcp": "^0.0.85",
    "@types/css-tree": "^2.3.11",
    "@types/culori": "^4.0.1",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.61.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
